---
layout: default
---
{% comment %}
  Home page: intro (photo, name, bio, socials), then the sections enabled in
  the page front matter: featured work, a blog series, news.
{% endcomment %}
<div class="post home">
  <header class="home-intro">
    {% if page.profile.image %}
      <img
        class="home-photo"
        src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
        alt="{{ site.first_name }} {{ site.last_name }}"
      >
    {% endif %}
    <div class="home-intro-text">
      <h1 class="post-title">{{ site.first_name }} {{ site.last_name }}</h1>
      {% if page.subtitle %}<p class="home-subtitle">{{ page.subtitle }}</p>{% endif %}
      <div class="home-bio">{{ content }}</div>
      {% if page.social %}
        <div class="social home-social">
          <div class="contact-icons">{% include social.liquid %}</div>
        </div>
      {% endif %}
    </div>
  </header>

  <article>
    {% if page.featured %}
      <h2 class="section-label">Featured work</h2>
      {% include featured_papers.liquid %}
      <p class="section-more"><a href="{{ '/publications/' | relative_url }}">All publications →</a></p>
    {% endif %}

    {% if page.series %}
      {% assign series = site.data.series[page.series.key] %}
      <h2 class="section-label"><a href="{{ series.url | relative_url }}">{{ series.title }}</a></h2>
      {% include series_outline.liquid key=page.series.key limit=page.series.limit %}
      <p class="section-more"><a href="{{ series.url | relative_url }}">The full series →</a></p>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <h2 class="section-label"><a href="{{ '/news/' | relative_url }}">News</a></h2>
      {% include news.liquid limit=true %}
    {% endif %}
  </article>
</div>
