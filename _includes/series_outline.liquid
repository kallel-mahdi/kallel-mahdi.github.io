{% comment %}
  Ordered list of a series' parts: published parts link to their post,
  planned parts are greyed out. Usage: {% include series_outline.liquid key="rl-by-doing" limit=3 %}
{% endcomment %}
{% assign series = site.data.series[include.key] %}
{% assign series_posts = site.posts | where: 'series', include.key %}
<ol class="series-outline">
  {% for item in series.outline %}
    {% if include.limit and forloop.index > include.limit %}{% break %}{% endif %}
    {% assign post = series_posts | where: 'part', item.part | first %}
    <li class="{% if post %}is-published{% else %}is-planned{% endif %}">
      <span class="series-outline-num">{{ item.part }}</span>
      <div class="series-outline-text">
        {% if post %}
          <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
        {% else %}
          <span class="series-outline-title">{{ item.title }}</span>
        {% endif %}
        {% if include.goals %}<span class="series-outline-goal">{{ item.goal }}</span>{% endif %}
      </div>
      <span class="series-outline-status">{% if post %}read →{% else %}soon{% endif %}</span>
    </li>
  {% endfor %}
</ol>
