{% comment %} Featured paper cards from _data/featured.yml. {% endcomment %}
<div class="featured-grid">
  {% for paper in site.data.featured %}
    {% if paper.url contains '://' %}
      {% assign href = paper.url %}
    {% else %}
      {% assign href = paper.url | relative_url %}
    {% endif %}
    <a class="featured-card" href="{{ href }}">
      <div class="featured-figure">
        <img src="{{ paper.image | prepend: '/assets/img/' | relative_url }}" alt="{{ paper.title }}" loading="lazy">
      </div>
      <div class="featured-body">
        <span class="featured-venue">{{ paper.venue }}</span>
        <span class="featured-title">{{ paper.title }}</span>
        <span class="featured-takeaway">{{ paper.takeaway }}</span>
      </div>
    </a>
  {% endfor %}
</div>
